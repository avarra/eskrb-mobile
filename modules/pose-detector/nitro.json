{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["posedetector"],
  "ios": { "iosModuleName": "NitroPoseDetector" },
  "android": { "androidNamespace": ["posedetector"], "androidCxxLibName": "NitroPoseDetector" },
  "autolinking": {
    "PoseDetector": {
      "ios": { "language": "swift", "implementationClassName": "HybridPoseDetector" },
      "android": { "language": "kotlin", "implementationClassName": "HybridPoseDetector" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
