+    // eSkrb patch: on-device support for a specific locale (upstream only checks the default locale).
+    Function("supportsOnDeviceRecognitionForLocale") { (localeIdentifier: String) -> Bool in
+      let normalized = localeIdentifier.replacingOccurrences(of: "_", with: "-")
+      guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: normalized)) else {
+        return false
+      }
+      return recognizer.supportsOnDeviceRecognition
+    }
+
     Function("supportsRecording") { () -> Bool in
       return true
     }
