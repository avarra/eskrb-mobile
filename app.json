{
  "expo": {
    "name": "eSkrb",
    "slug": "eskrb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eskrb",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "dev.avarra.eskrb",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,
        "CFBundleDevelopmentRegion": "sl",
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Da lahko zapis narekujete namesto tipkate. Zvok ostane na telefonu.",
        "NSSpeechRecognitionUsageDescription": "Da lahko zapis narekujete namesto tipkate. Zvok ostane na telefonu.",
        "NSCameraUsageDescription": "Za fotografijo rane, ki jo pregleda vaša ekipa.",
        "NSPhotoLibraryUsageDescription": "Da lahko izberete fotografijo rane, ki jo pregleda vaša ekipa."
      }
    },
    "android": {
      "package": "dev.avarra.eskrb",
      "adaptiveIcon": {
        "backgroundColor": "#1652C4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1652C4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
            "./node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
            "./node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Da lahko izberete fotografijo rane, ki jo pregleda vaša ekipa.",
          "cameraPermission": "Za fotografijo rane, ki jo pregleda vaša ekipa.",
          "microphonePermission": "Da lahko zapis narekujete namesto tipkate. Zvok ostane na telefonu."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Da lahko zapis narekujete namesto tipkate. Zvok ostane na telefonu.",
          "speechRecognitionPermission": "Da lahko zapis narekujete namesto tipkate. Zvok ostane na telefonu.",
          "androidSpeechServicePackages": ["com.google.android.as"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1652C4",
          "enableRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f17ead14-6c25-42e3-a99e-11395a2e64c7"
      }
    },
    "owner": "avarra"
  }
}
